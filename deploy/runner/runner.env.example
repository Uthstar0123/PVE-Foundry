# Install as /etc/pve-foundry/runner.env with owner root:pve-foundry and mode 0640.
RUNNER_ENVIRONMENT=production
RUNNER_MANAGEMENT_URL=https://management.example.local:8443
RUNNER_MANAGEMENT_CA_FILE=/etc/pve-foundry/management-ca.pem
RUNNER_RUNNER_TOKEN=replace-with-the-same-random-token-as-MANAGEMENT_RUNNER_TOKEN
RUNNER_OPENTOFU_BINARY=/usr/bin/tofu
RUNNER_WORK_ROOT=/var/lib/pve-foundry/jobs
RUNNER_STATE_ROOT=/var/lib/pve-foundry/state

# bpg/proxmox provider. Replace every placeholder; never commit real secrets.
PROXMOX_VE_ENDPOINT=https://pve.example.local:8006/
PROXMOX_VE_API_TOKEN=foundry-rw@pve!OpenTofu=replace-with-real-token-secret
PROXMOX_VE_INSECURE=false
