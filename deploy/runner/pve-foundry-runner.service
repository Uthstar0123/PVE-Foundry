[Unit]
Description=PVE Foundry isolated OpenTofu Runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pve-foundry
Group=pve-foundry
EnvironmentFile=/etc/pve-foundry/runner.env
ExecStart=/usr/local/bin/pve-foundry-runner
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

# Limits apply to the runner, OpenTofu and all provider processes.
CPUQuota=100%
MemoryMax=2G
TasksMax=128
LimitNOFILE=1024
LimitNPROC=128

StateDirectory=pve-foundry
StateDirectoryMode=0700
ReadWritePaths=/var/lib/pve-foundry
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Do not add RestrictNamespaces or a syscall allowlist blindly:
# bubblewrap needs user/mount namespaces for its per-job sandbox.

[Install]
WantedBy=multi-user.target
