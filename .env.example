# Management API
MANAGEMENT_ADDRESS=:8080
MANAGEMENT_ENVIRONMENT=development
MANAGEMENT_DATABASE_URL=postgres://orchestrator:change-me@127.0.0.1:5432/orchestrator?sslmode=disable
# Generate two distinct values with: openssl rand -base64 32
MANAGEMENT_AUTH_KEY=replace-with-base64-encoded-32-byte-key
MANAGEMENT_ENCRYPTION_KEY=replace-with-another-base64-encoded-32-byte-key

# Optional read-only Proxmox inventory. URL and token must be set together.
# Token format: user@realm!token-id=secret
MANAGEMENT_PROXMOX_API_URL=
MANAGEMENT_PROXMOX_API_TOKEN=
# Recommended for a private/self-signed Proxmox CA in production.
MANAGEMENT_PROXMOX_CA_FILE=
# Development/test only; never enable in production.
MANAGEMENT_PROXMOX_INSECURE_SKIP_VERIFY=false

# Management authenticates the isolated Runner with this shared random token.
# Use another independently generated value outside local development.
MANAGEMENT_RUNNER_TOKEN=development-only-runner-token-change-in-production

# Runner polls Management and does not open a listening port.
RUNNER_ENVIRONMENT=development
RUNNER_MANAGEMENT_URL=http://127.0.0.1:8080
RUNNER_MANAGEMENT_CA_FILE=
RUNNER_RUNNER_TOKEN=development-only-runner-token-change-in-production
RUNNER_OPENTOFU_BINARY=tofu
RUNNER_WORK_ROOT=./tmp/runner-jobs
RUNNER_STATE_ROOT=./tmp/runner-state

# Never commit real Proxmox tokens, passwords or private keys.
